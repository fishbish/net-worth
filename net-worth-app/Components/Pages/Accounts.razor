@page "/accounts"
@attribute [Authorize]
@inject AccountService AccountService
@inject InstitutionService InstitutionService
@inject InstrumentService InstrumentService

<PageTitle>Accounts</PageTitle>

<h1>Accounts</h1>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <div class="alert alert-success" role="alert">@_successMessage</div>
}

@if (_institutions.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        No institutions exist yet. Create catalogue data first, then add accounts.
    </div>
}

<EditForm Model="_editModel" OnValidSubmit="SaveAsync" FormName="save-account" class="card p-3 mb-4">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="name">Name</label>
            <InputText id="name" class="form-control" @bind-Value="_editModel.Name" />
        </div>
        <div class="col-md-6">
            <label class="form-label" for="institution">Institution</label>
            <InputSelect id="institution" class="form-select" @bind-Value="_editModel.InstitutionId">
                <option value="@Guid.Empty">Select institution</option>
                @foreach (var institution in _institutions.OrderBy(x => x.Name, StringComparer.CurrentCultureIgnoreCase))
                {
                    <option value="@institution.InstitutionId">@institution.Name</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-6">
            <label class="form-label" for="category">Category</label>
            <InputSelect id="category" class="form-select" @bind-Value="_editModel.Category">
                @foreach (var category in Enum.GetValues<AccountCategory>())
                {
                    <option value="@category">@category</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-6">
            <label class="form-label" for="type">Type</label>
            <InputSelect id="type" class="form-select" @bind-Value="_editModel.Type">
                @foreach (var type in Enum.GetValues<AccountType>().OrderBy(x => x.ToString(), StringComparer.CurrentCulture))
                {
                    <option value="@type">@type</option>
                }
            </InputSelect>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@(_isSaving || _institutions.Count == 0)">
            @(_isEditing ? "Update account" : "Create account")
        </button>
        @if (_isEditing)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">Cancel</button>
        }
    </div>
</EditForm>

@if (_isLoading)
{
    <p>Loading accounts...</p>
}
else if (_accounts.Count == 0)
{
    <p>No accounts yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Institution</th>
                <th>Category</th>
                <th>Type</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var account in _accounts)
            {
                <tr>
                    <td>@account.Name</td>
                    <td>@account.InstitutionName</td>
                    <td>@account.Category</td>
                    <td>@account.Type</td>
                    <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-secondary me-2" @onclick="() => ToggleInstrumentsAsync(account)">
                            @(_selectedAccountId == account.AccountId ? "Hide instruments" : "Manage instruments")
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="() => BeginEdit(account)">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(account.AccountId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_selectedAccountId.HasValue)
{
    <div class="card p-3">
        <h4>Instruments for @_selectedAccountName</h4>

        <div class="row g-4 mb-4">
            <div class="col-lg-5">
                <div class="border rounded p-3 h-100">
                    <h5 class="h6">Link existing instrument</h5>

                    @if (_availableInstruments.Count == 0)
                    {
                        <p class="mb-0 text-muted">All catalogue instruments are already linked to this account.</p>
                    }
                    else
                    {
                        <EditForm Model="_linkInstrumentModel" OnValidSubmit="LinkInstrumentAsync" FormName="link-instrument">
                            <div class="row g-3 align-items-end">
                                <div class="col-12">
                                    <label class="form-label" for="existingInstrument">Instrument</label>
                                    <InputSelect id="existingInstrument" class="form-select" @bind-Value="_linkInstrumentModel.InstrumentId">
                                        <option value="@Guid.Empty">Select instrument</option>
                                        @foreach (var instrument in _availableInstruments)
                                        {
                                            <option value="@instrument.InstrumentId">@instrument.DisplayName</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-outline-primary" disabled="@_isSavingInstrument">Link instrument</button>
                                </div>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>

            <div class="col-lg-7">
                <div class="border rounded p-3 h-100">
                    <h5 class="h6">@(_isEditingInstrument ? "Edit instrument" : "Create and link new instrument")</h5>

                    <EditForm Model="_instrumentEditModel" OnValidSubmit="SaveInstrumentAsync" FormName="save-instrument">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row g-3">
                            <div class="col-md-5">
                                <label class="form-label" for="instrumentName">Name</label>
                                <InputText id="instrumentName" class="form-control" @bind-Value="_instrumentEditModel.Name" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="ticker">Ticker</label>
                                <InputText id="ticker" class="form-control" @bind-Value="_instrumentEditModel.Ticker" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="instrumentType">Type</label>
                                <InputSelect id="instrumentType" class="form-select" @bind-Value="_instrumentEditModel.Type">
                                    @foreach (var type in Enum.GetValues<InstrumentType>().OrderBy(x => x.ToString(), StringComparer.CurrentCulture))
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@_isSavingInstrument">
                                @(_isEditingInstrument ? "Update instrument" : "Create and link")
                            </button>
                            @if (_isEditingInstrument)
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="ResetInstrumentForm">Cancel instrument edit</button>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        @if (_isLoadingInstruments)
        {
            <p>Loading instruments...</p>
        }
        else if (_instruments.Count == 0)
        {
            <p>No instruments for this account.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Ticker</th>
                        <th>Type</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var instrument in _instruments)
                    {
                        <tr>
                            <td>@instrument.Name</td>
                            <td>@(string.IsNullOrWhiteSpace(instrument.Ticker) ? "-" : instrument.Ticker)</td>
                            <td>@instrument.Type</td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="() => BeginInstrumentEdit(instrument)">Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => UnlinkInstrumentAsync(instrument.InstrumentId)">Unlink</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private readonly List<AccountLookup> _accounts = [];
    private readonly List<Institution> _institutions = [];
    private readonly List<InstrumentLookup> _availableInstruments = [];
    private readonly List<InstrumentLookup> _instruments = [];

    private AccountUpsert _editModel = new();
    private InstrumentLinkModel _linkInstrumentModel = new();
    private InstrumentUpsert _instrumentEditModel = new();

    private Guid? _selectedAccountId;
    private string _selectedAccountName = string.Empty;

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isEditing;

    private bool _isLoadingInstruments;
    private bool _isSavingInstrument;
    private bool _isEditingInstrument;

    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _accounts.Clear();
            _institutions.Clear();
            _accounts.AddRange(await AccountService.GetAccountsAsync());
            _institutions.AddRange(await InstitutionService.GetInstitutionsAsync());
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await AccountService.SaveAsync(_editModel);
            _successMessage = _isEditing ? "Account updated." : "Account created.";
            await LoadAsync();
            ResetForm();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (DbUpdateException ex)
        {
            _errorMessage = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleInstrumentsAsync(AccountLookup account)
    {
        _errorMessage = null;
        _successMessage = null;

        if (_selectedAccountId == account.AccountId)
        {
            ResetSelectedAccountInstruments();
            return;
        }

        _selectedAccountId = account.AccountId;
        _selectedAccountName = account.Name;
        ResetInstrumentForm();
        _linkInstrumentModel = new InstrumentLinkModel();
        await LoadInstrumentsAsync();
    }

    private async Task LoadInstrumentsAsync()
    {
        if (!_selectedAccountId.HasValue)
        {
            return;
        }

        _isLoadingInstruments = true;

        try
        {
            var linkedTask = InstrumentService.GetByAccountAsync(_selectedAccountId.Value);
            var availableTask = InstrumentService.GetAvailableForAccountAsync(_selectedAccountId.Value);

            await Task.WhenAll(linkedTask, availableTask);

            _instruments.Clear();
            _instruments.AddRange(linkedTask.Result);

            _availableInstruments.Clear();
            _availableInstruments.AddRange(availableTask.Result);

            _linkInstrumentModel = new InstrumentLinkModel();
        }
        finally
        {
            _isLoadingInstruments = false;
        }
    }

    private async Task LinkInstrumentAsync()
    {
        if (!_selectedAccountId.HasValue)
        {
            return;
        }

        _isSavingInstrument = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await InstrumentService.LinkAsync(_selectedAccountId.Value, _linkInstrumentModel.InstrumentId);
            _successMessage = "Instrument linked.";
            await LoadInstrumentsAsync();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (DbUpdateException ex)
        {
            _errorMessage = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _isSavingInstrument = false;
        }
    }

    private async Task SaveInstrumentAsync()
    {
        if (!_selectedAccountId.HasValue)
        {
            return;
        }

        _isSavingInstrument = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await InstrumentService.SaveAsync(_selectedAccountId.Value, _instrumentEditModel);
            _successMessage = _isEditingInstrument ? "Shared instrument updated." : "Instrument created and linked.";
            await LoadInstrumentsAsync();
            ResetInstrumentForm();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (DbUpdateException ex)
        {
            _errorMessage = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _isSavingInstrument = false;
        }
    }

    private void BeginInstrumentEdit(InstrumentLookup instrument)
    {
        _isEditingInstrument = true;
        _instrumentEditModel = new InstrumentUpsert
        {
            InstrumentId = instrument.InstrumentId,
            Name = instrument.Name,
            Ticker = instrument.Ticker,
            Type = instrument.Type
        };
    }

    private async Task UnlinkInstrumentAsync(Guid instrumentId)
    {
        if (!_selectedAccountId.HasValue)
        {
            return;
        }

        _isSavingInstrument = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await InstrumentService.UnlinkAsync(_selectedAccountId.Value, instrumentId);
            _successMessage = "Instrument unlinked.";
            await LoadInstrumentsAsync();
            ResetInstrumentForm();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (DbUpdateException ex)
        {
            _errorMessage = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _isSavingInstrument = false;
        }
    }

    private void BeginEdit(AccountLookup account)
    {
        _isEditing = true;
        _errorMessage = null;
        _successMessage = null;
        _editModel = new AccountUpsert
        {
            AccountId = account.AccountId,
            Name = account.Name,
            Category = account.Category,
            Type = account.Type,
            InstitutionId = account.InstitutionId
        };
    }

    private async Task DeleteAsync(Guid accountId)
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await AccountService.DeleteAsync(accountId);
            _successMessage = "Account deleted.";

            if (_selectedAccountId == accountId)
            {
                ResetSelectedAccountInstruments();
            }

            await LoadAsync();
            ResetForm();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (DbUpdateException ex)
        {
            _errorMessage = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private void ResetForm()
    {
        _isEditing = false;
        _editModel = new AccountUpsert();
    }

    private void ResetInstrumentForm()
    {
        _isEditingInstrument = false;
        _instrumentEditModel = new InstrumentUpsert();
    }

    private void ResetSelectedAccountInstruments()
    {
        _selectedAccountId = null;
        _selectedAccountName = string.Empty;
        _availableInstruments.Clear();
        _instruments.Clear();
        _linkInstrumentModel = new InstrumentLinkModel();
        ResetInstrumentForm();
    }

    private class InstrumentLinkModel
    {
        public Guid InstrumentId { get; set; }
    }
}
